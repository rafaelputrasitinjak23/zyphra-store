<section class="admin-shell">
  <%- include('../../partials/admin-nav') %>
  <div class="admin-content">
    <div class="admin-head">
      <div><span class="eyebrow">PROMOSI</span><h1>Voucher & kode promo</h1><p>Kelola potongan belanja dan voucher saldo dari satu tempat.</p></div>
      <a class="button" href="/admin/discounts/new">Tambah program</a>
    </div>
    <% if (!discounts.length) { %>
      <div class="empty"><h3>Belum ada program promosi</h3><p>Buat promo pertama untuk pengguna toko.</p></div>
    <% } else { %>
      <div class="table-wrap panel"><table><thead><tr><th>Kode</th><th>Manfaat</th><th>Nilai</th><th>Cakupan</th><th>Periode</th><th>Penggunaan</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
        <% discounts.forEach(discount => { const activeNow = discount.active && new Date() >= discount.startsAt && new Date() < discount.endsAt; %>
          <tr>
            <td><strong><%= discount.code %></strong><br><small><%= discount.name %></small></td>
            <td><span class="badge"><%= discount.benefitType === 'wallet_credit' ? 'Voucher saldo' : (discount.kind === 'voucher' ? 'Voucher belanja' : 'Kode promo') %></span></td>
            <td><% if (discount.benefitType === 'wallet_credit') { %><strong>+<%= rupiah(discount.walletCreditAmount || discount.value) %></strong><% } else { %><%= discount.discountType === 'percentage' ? `${discount.value}%` : rupiah(discount.value) %><% if (discount.maxDiscount > 0 && discount.discountType === 'percentage') { %><br><small>Maks. <%= rupiah(discount.maxDiscount) %></small><% } %><% } %></td>
            <td><%= discount.benefitType === 'wallet_credit' ? 'Dompet pengguna' : (discount.scope === 'all' ? 'Semua produk' : `${discount.products.length} produk`) %></td>
            <td><small><%= formatDate(discount.startsAt) %><br>s.d. <%= formatDate(discount.endsAt) %></small></td>
            <td><%= discount.usedCount %>/<%= discount.usageLimit > 0 ? discount.usageLimit : '∞' %></td>
            <td><span class="badge <%= activeNow ? 'badge-success' : '' %>"><%= discount.active ? (activeNow ? 'Aktif' : 'Terjadwal/berakhir') : 'Nonaktif' %></span></td>
            <td><div class="inline-actions"><a class="button button-sm button-ghost" href="/admin/discounts/<%= discount._id %>/edit">Edit</a><form method="post" action="/admin/discounts/<%= discount._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit"><%= discount.active ? 'Nonaktifkan' : 'Aktifkan' %></button></form></div></td>
          </tr>
        <% }) %>
      </tbody></table></div>
    <% } %>
  </div>
</section>
