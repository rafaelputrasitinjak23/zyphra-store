<section class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">KONFIGURASI</span><h1>Pengaturan toko</h1><p>Kelola metode pembayaran dan batas deposit dompet.</p></div></div><form class="panel form-stack" method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="settings-section"><h2>TOKOZYPHRA Wallet</h2><div class="form-grid"><label class="check span-2"><input type="checkbox" name="walletEnabled" <%= settings.wallet?.enabled ? 'checked' : '' %>> Aktifkan deposit saldo</label><label>Minimum deposit<input type="number" min="1000" step="1000" name="walletMinDeposit" value="<%= settings.wallet?.minDeposit || 10000 %>"></label><label>Maksimum deposit<input type="number" min="1000" step="1000" name="walletMaxDeposit" value="<%= settings.wallet?.maxDeposit || 5000000 %>"></label></div></section>
  <section class="settings-section"><h2>Metode pembayaran</h2><label>Batas kebijakan biaya<input type="number" min="0" name="feeSplitThreshold" value="<%= settings.feeSplitThreshold %>"></label><div class="table-wrap"><table><thead><tr><th>Metode</th><th>Aktif</th><th>Konfigurasi</th></tr></thead><tbody><% settings.paymentFees.forEach(fee => { %><tr><td><strong><%= fee.label %></strong><small><%= fee.method %></small></td><td><label class="check"><input type="checkbox" name="active_<%= fee.method %>" <%= fee.active ? 'checked' : '' %>> Aktif</label></td><td><% if (fee.type === 'fixed') { %><label>Biaya tetap<input type="number" name="fixed_<%= fee.method %>" value="<%= fee.fixed %>"></label><% } else { %><div class="mini-grid"><label>Persentase<input type="number" step="0.0001" name="percentage_<%= fee.method %>" value="<%= fee.percentage %>"></label><label>Biaya tetap<input type="number" name="fixed_<%= fee.method %>" value="<%= fee.fixed %>"></label><% if (fee.type === 'tiered_qris') { %><label>Persentase tinggi<input type="number" step="0.0001" name="highPercentage_<%= fee.method %>" value="<%= fee.highPercentage %>"></label><label>Batas tinggi<input type="number" name="highThreshold_<%= fee.method %>" value="<%= fee.highThreshold %>"></label><% } %></div><% } %></td></tr><% }) %></tbody></table></div></section>
  <button class="button" type="submit">Simpan pengaturan</button>
</form></div></section>
