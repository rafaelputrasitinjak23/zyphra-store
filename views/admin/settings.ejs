<section class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">KONFIGURASI</span><h1>Fee pembayaran</h1></div></div><form class="panel form-stack" method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Batas pembagian fee<input type="number" min="0" name="feeSplitThreshold" value="<%= settings.feeSplitThreshold %>"><small>Di bawah nilai ini fee dibagi dua.</small></label><div class="table-wrap"><table><thead><tr><th>Metode</th><th>Aktif</th><th>Konfigurasi</th></tr></thead><tbody><% settings.paymentFees.forEach(fee => { %><tr><td><strong><%= fee.label %></strong><small><%= fee.method %></small></td><td><label class="check"><input type="checkbox" name="active_<%= fee.method %>" <%= fee.active ? 'checked' : '' %>> Aktif</label></td><td><% if (fee.type === 'fixed') { %><label>Fee tetap<input type="number" name="fixed_<%= fee.method %>" value="<%= fee.fixed %>"></label><% } else { %><div class="mini-grid"><label>Persentase<input type="number" step="0.0001" name="percentage_<%= fee.method %>" value="<%= fee.percentage %>"></label><label>Fee tetap<input type="number" name="fixed_<%= fee.method %>" value="<%= fee.fixed %>"></label><% if (fee.type === 'tiered_qris') { %><label>Persentase tinggi<input type="number" step="0.0001" name="highPercentage_<%= fee.method %>" value="<%= fee.highPercentage %>"></label><label>Batas tinggi<input type="number" name="highThreshold_<%= fee.method %>" value="<%= fee.highThreshold %>"></label><% } %></div><% } %></td></tr><% }) %></tbody></table></div><div class="notice"><strong>Penting</strong><p>Sesuaikan data fee ketika Pakasir memperbarui biaya. Respons aktual API tetap direkonsiliasi sebelum order disimpan.</p></div><button class="button" type="submit">Simpan pengaturan</button></form></div></section>
