<section class="admin-shell">
  <%- include('../../partials/admin-nav') %>
  <div class="admin-content">
    <div class="admin-head">
      <div><span class="eyebrow">PRODUK</span><h1><%= product ? 'Edit produk' : 'Tambah produk' %></h1></div>
      <a class="button button-ghost" href="/admin/products">Kembali</a>
    </div>
    <form class="panel form-grid" method="post" action="<%= product ? `/admin/products/${product._id}` : '/admin/products' %>" data-product-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nama produk<input name="name" value="<%= product?.name || '' %>" required></label>
      <label>Slug<input name="slug" value="<%= product?.slug || '' %>" placeholder="otomatis dari nama"></label>
      <label>Kategori<select name="category" required data-category-select><option value="">Pilih kategori</option><% categories.forEach(category => { %><option value="<%= category._id %>" data-name="<%= category.name %>" <%= String(product?.category?._id || product?.category || '') === String(category._id) ? 'selected' : '' %>><%= category.name %></option><% }) %></select></label>
      <label>Versi<input name="version" value="<%= product?.version || '1.0.0' %>"></label>
      <label>Harga<input type="number" name="price" min="0" value="<%= product?.price ?? 0 %>" required></label>
      <label>Harga promo<input type="number" name="promoPrice" min="0" value="<%= product?.promoPrice ?? '' %>"></label>
      <label class="span-2">Tags<input name="tags" value="<%= product?.tags?.join(', ') || '' %>" placeholder="nodejs, bot, api"></label>
      <div class="span-2 ai-copy-box">
        <div><strong>Isi deskripsi otomatis dengan AI</strong><p>AI akan membuat deskripsi singkat, deskripsi lengkap, tags, instruksi, dan changelog berdasarkan nama serta kategori.</p></div>
        <button class="button button-ghost" type="button" data-ai-product-copy>Generate dengan AI</button>
      </div>
      <label class="span-2">Deskripsi singkat<textarea name="shortDescription" required maxlength="300"><%= product?.shortDescription || '' %></textarea></label>
      <label class="span-2">Deskripsi lengkap<textarea name="description" rows="10" required><%= product?.description || '' %></textarea></label>
      <label class="span-2">Thumbnail URL<input type="url" name="thumbnail" value="<%= product?.thumbnail || '' %>" required></label>
      <label class="span-2">Galeri URL (satu per baris)<textarea name="gallery"><%= product?.gallery?.join('\n') || '' %></textarea></label>
      <label class="span-2">URL file digital rahasia<input type="url" name="digitalFileUrl" value="<%= product?.digitalFileUrl || '' %>" required><small>URL ini tidak pernah dikirim ke view publik.</small></label>
      <label>Nama file download<input name="fileName" value="<%= product?.fileName || '' %>" placeholder="produk.zip"></label>
      <label>Batas download<input type="number" name="downloadLimit" min="1" value="<%= product?.downloadLimit || 5 %>"></label>
      <label>Stok<input type="number" name="stock" min="0" value="<%= product?.stock || 0 %>"></label>
      <label class="span-2">Changelog<textarea name="changelog" rows="6"><%= product?.changelog || '' %></textarea></label>
      <label class="span-2">Instruksi penggunaan<textarea name="instructions" rows="7"><%= product?.instructions || '' %></textarea></label>
      <div class="check-grid span-2">
        <label class="check"><input type="checkbox" name="unlimitedStock" <%= product ? (product.unlimitedStock ? 'checked' : '') : 'checked' %>> Stok unlimited</label>
        <label class="check"><input type="checkbox" name="allowMultipleQuantity" <%= product?.allowMultipleQuantity ? 'checked' : '' %>> Izinkan jumlah lebih dari satu</label>
        <label class="check"><input type="checkbox" name="active" <%= product ? (product.active ? 'checked' : '') : 'checked' %>> Aktif</label>
        <label class="check"><input type="checkbox" name="featured" <%= product?.featured ? 'checked' : '' %>> Unggulan</label>
      </div>
      <div class="span-2"><button class="button" type="submit">Simpan produk</button></div>
    </form>
  </div>
</section>
