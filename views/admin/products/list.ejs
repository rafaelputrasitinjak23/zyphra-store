<section class="admin-shell"><%- include('../../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">KATALOG</span><h1>Kelola produk</h1></div><a class="button" href="/admin/products/new">Tambah produk</a></div><div class="table-wrap panel"><table><thead><tr><th>Produk</th><th>Kategori</th><th>Harga</th><th>Stok</th><th>Status</th><th></th></tr></thead><tbody><% products.forEach(product => { %><tr><td><div class="table-product"><img src="<%= product.thumbnail %>" alt=""><div><strong><%= product.name %></strong><small><%= product.slug %></small></div></div></td><td><%= product.category?.name || '-' %></td><td><%= rupiah(product.promoPrice !== null ? product.promoPrice : product.price) %></td><td><%= product.unlimitedStock ? 'Unlimited' : product.stock %></td><td><span class="status <%= product.active ? 'status-paid' : 'status-cancelled' %>"><%= product.active ? 'aktif' : 'nonaktif' %></span></td><td><div class="row-actions"><a href="/admin/products/<%= product._id %>/edit">Edit</a><form method="post" action="/admin/products/<%= product._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button"><%= product.active ? 'Nonaktifkan' : 'Aktifkan' %></button></form></div></td></tr><% }) %></tbody></table></div></div></section>
