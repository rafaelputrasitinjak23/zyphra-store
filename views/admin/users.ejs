<section class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">AKUN</span><h1>Pengguna</h1></div></div><div class="table-wrap panel"><table><thead><tr><th>Pengguna</th><th>Metode login</th><th>Dibuat</th><th>Role & status</th></tr></thead><tbody><% users.forEach(user => { %><tr><td><strong><%= user.name %></strong><small><%= user.email %></small></td><td>Email + OTP</td><td><%= formatDate(user.createdAt) %></td><td><form class="row-actions" method="post" action="/admin/users/<%= user._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="role"><option value="user" <%= user.role === 'user' ? 'selected' : '' %>>user</option><option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>admin</option></select><select name="status"><option value="active" <%= user.status === 'active' ? 'selected' : '' %>>active</option><option value="blocked" <%= user.status === 'blocked' ? 'selected' : '' %>>blocked</option><option value="pending" <%= user.status === 'pending' ? 'selected' : '' %>>pending</option></select><button class="button button-sm button-ghost">Simpan</button></form></td></tr><% }) %></tbody></table></div></div></section>
