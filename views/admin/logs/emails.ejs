<section class="admin-shell"><%- include('../../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">LOG</span><h1>Email</h1></div></div><div class="table-wrap panel"><table><thead><tr><th>Waktu</th><th>Penerima</th><th>Subjek</th><th>Template</th><th>Status</th><th></th></tr></thead><tbody><% logs.forEach(log => { %><tr><td><%= formatDate(log.createdAt) %></td><td><%= log.to %></td><td><%= log.subject %></td><td><%= log.template || '-' %></td><td><span class="status status-<%= log.status === 'sent' ? 'paid' : 'failed' %>"><%= log.status %></span><% if (log.error) { %><small><%= log.error %></small><% } %></td><td><% if (log.status === 'failed' && log.retryType) { %><form method="post" action="/admin/logs/emails/<%= log._id %>/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-sm button-ghost">Coba ulang</button></form><% } %></td></tr><% }) %></tbody></table></div></div></section>
