<section class="admin-shell"><%- include('../../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">LOG</span><h1>Webhook Pakasir</h1></div></div><div class="table-wrap panel"><table><thead><tr><th>Waktu</th><th>Pesanan</th><th>Status</th><th>Payload</th></tr></thead><tbody><% logs.forEach(log => { %><tr><td><%= formatDate(log.createdAt) %></td><td><%= log.orderNumber || '-' %></td><td><span class="status status-<%= log.status === 'processed' ? 'paid' : log.status === 'failed' ? 'failed' : 'pending' %>"><%= log.status %></span><% if (log.error) { %><small><%= log.error %></small><% } %></td><td><details><summary>Lihat</summary><pre class="json"><%= JSON.stringify(log.payload, null, 2) %></pre></details></td></tr><% }) %></tbody></table></div></div></section>
