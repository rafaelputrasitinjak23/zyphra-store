<section class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">KATALOG</span><h1>Kategori</h1></div></div><div class="settings-grid"><form class="panel form-stack" method="post" action="/admin/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Tambah kategori</h2><label>Nama<input name="name" required></label><label>Slug<input name="slug"></label><label>Deskripsi<textarea name="description"></textarea></label><button class="button" type="submit">Tambah</button></form><div class="panel"><h2>Daftar kategori</h2><div class="stack-list"><% categories.forEach(category => { %><form method="post" action="/admin/categories/<%= category._id %>" class="inline-edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" value="<%= category.name %>" required><input name="slug" value="<%= category.slug %>" required><input name="description" value="<%= category.description %>"><label class="check"><input type="checkbox" name="active" <%= category.active ? 'checked' : '' %>> Aktif</label><button class="button button-sm button-ghost">Simpan</button></form><% }) %></div></div></div></div></section>
