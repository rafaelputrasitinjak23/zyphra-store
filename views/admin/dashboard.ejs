<section class="admin-shell"><%- include('../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">ADMIN</span><h1>Dashboard</h1></div></div><div class="stat-grid"><article><span>Pengguna</span><strong><%= stats.users %></strong></article><article><span>Produk</span><strong><%= stats.products %></strong></article><article><span>Pesanan</span><strong><%= stats.orders %></strong></article><article><span>Transaksi berhasil</span><strong><%= stats.count %></strong></article><article><span>Pendapatan kotor</span><strong><%= rupiah(stats.gross) %></strong></article><article><span>Fee pengguna</span><strong><%= rupiah(stats.userFees) %></strong></article><article><span>Fee merchant</span><strong><%= rupiah(stats.merchantFees) %></strong></article><article><span>Net merchant</span><strong><%= rupiah(stats.net) %></strong></article></div><div class="panel"><div class="panel-head"><h2>Transaksi 30 hari</h2></div><div class="bar-chart"><% const max = Math.max(1, ...chart.map(i => i.total)); chart.forEach(item => { %><div class="bar-item" title="<%= item._id %>: <%= rupiah(item.total) %>"><div style="height:<%= Math.max(6, Math.round(item.total / max * 100)) %>%"></div><span><%= item._id.slice(5) %></span></div><% }) %><% if (!chart.length) { %><div class="empty compact">Belum ada transaksi berhasil.</div><% } %></div></div><div class="panel"><div class="panel-head"><h2>Pesanan terbaru</h2><a href="/admin/orders">Lihat semua</a></div><div class="table-wrap"><table><thead><tr><th>Pesanan</th><th>Pengguna</th><th>Total</th><th>Status</th></tr></thead><tbody><% recent.forEach(order => { %><tr><td><a href="/admin/orders/<%= order.orderNumber %>"><%= order.orderNumber %></a></td><td><%= order.user?.email || order.buyerSnapshot.email %></td><td><%= rupiah(order.total) %></td><td><span class="status status-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></td></tr><% }) %></tbody></table></div></div></div></section>
