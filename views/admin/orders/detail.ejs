<section class="admin-shell">
  <%- include('../../partials/admin-nav') %>
  <div class="admin-content">
    <div class="admin-head"><div><span class="eyebrow">PESANAN</span><h1><%= order.orderNumber %></h1></div><span class="status status-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></div>
    <div class="settings-grid">
      <div class="panel"><h2>Produk</h2><% order.items.forEach(item => { %><div class="order-item"><img src="<%= item.thumbnail %>" alt=""><div><strong><%= item.name %></strong><span><%= item.quantity %> × <%= rupiah(item.unitPrice) %></span></div><b><%= rupiah(item.lineTotal) %></b></div><% }) %><h3>Pembeli</h3><p><%= order.user?.name || order.buyerSnapshot.name %><br><%= order.user?.email || order.buyerSnapshot.email %></p><% if (order.cancelledAt) { %><div class="notice notice-danger"><strong>Dibatalkan oleh <%= order.cancelledBy %></strong><p><%= order.cancellationReason || '-' %><br><%= formatDate(order.cancelledAt) %></p></div><% } %></div>
      <div class="summary-card"><h2>Rincian biaya</h2><div class="summary-row"><span>Subtotal produk</span><b><%= rupiah(order.itemsSubtotal || (order.subtotal + (order.discountAmount || 0))) %></b></div><% if (order.discountAmount > 0) { %><div class="summary-row discount-row"><span><%= order.discountKind === 'voucher' ? 'Voucher' : 'Kode promo' %> <strong><%= order.discountCodeText %></strong></span><b>-<%= rupiah(order.discountAmount) %></b></div><div class="summary-row"><span>Subtotal setelah diskon</span><b><%= rupiah(order.subtotal) %></b></div><% } %><div class="summary-row"><span>Gateway fee</span><b><%= rupiah(order.gatewayFee) %></b></div><div class="summary-row"><span>Fee pengguna</span><b><%= rupiah(order.userFee) %></b></div><div class="summary-row"><span>Fee merchant</span><b><%= rupiah(order.merchantFee) %></b></div><div class="summary-row"><span>Net merchant</span><b><%= rupiah(order.merchantNet) %></b></div><hr><div class="summary-row total"><span>Total</span><b><%= rupiah(order.total) %></b></div><% if (order.paymentMethod === 'free') { %><p class="muted">Pesanan gratis dikonfirmasi internal tanpa Pakasir.</p><% } else { %><p class="muted">Nominal API Pakasir: <%= rupiah(order.pakasirAmount) %></p><form method="post" action="/admin/orders/<%= order.orderNumber %>/recheck"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-block">Cek ulang ke Pakasir</button></form><% } %>
        <% if (order.paymentStatus === 'pending') { %><form method="post" action="/admin/orders/<%= order.orderNumber %>/cancel" data-confirm="Batalkan transaksi ini sebagai admin?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="reason" maxlength="300" placeholder="Alasan pembatalan (opsional)"><button class="button button-block button-danger-ghost">Batalkan transaksi</button></form><% } %>
        <form method="post" action="/admin/orders/<%= order.orderNumber %>/resend-invoice"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-block button-ghost">Kirim ulang invoice</button></form>
      </div>
    </div>
    <div class="panel"><h2>Data provider</h2><pre class="json"><%= JSON.stringify(payment?.lastCheckResponse || payment?.createResponse || {}, null, 2) %></pre></div>
  </div>
</section>
