<section class="admin-shell"><%- include('../../partials/admin-nav') %><div class="admin-content"><div class="admin-head"><div><span class="eyebrow">TRANSAKSI</span><h1>Pesanan</h1></div><form method="get"><select name="status" onchange="this.form.submit()"><option value="">Semua status</option><% ['pending','paid','failed','expired','cancelled','refunded'].forEach(value => { %><option value="<%= value %>" <%= status === value ? 'selected' : '' %>><%= value %></option><% }) %></select></form></div><div class="table-wrap panel"><table><thead><tr><th>Pesanan</th><th>Pembeli</th><th>Biaya</th><th>Metode</th><th>Status</th><th></th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><strong><%= order.orderNumber %></strong><small><%= formatDate(order.createdAt) %></small></td><td><%= order.user?.email || order.buyerSnapshot.email %></td><td><strong><%= rupiah(order.total) %></strong><small>Net <%= rupiah(order.merchantNet) %></small></td><td><%= order.paymentMethod === 'free' ? 'Gratis' : order.paymentMethod %></td><td><span class="status status-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></td><td><a href="/admin/orders/<%= order.orderNumber %>">Detail →</a></td></tr><% }) %></tbody></table></div></div></section>
