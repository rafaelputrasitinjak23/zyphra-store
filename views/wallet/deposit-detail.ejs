<section class="page-head"><div class="container"><span class="eyebrow">DEPOSIT</span><h1>Isi saldo <%= rupiah(deposit.amount) %></h1><p>Selesaikan pembayaran sebelum batas waktu berakhir.</p></div></section>
<section class="section pt-small"><div class="container payment-layout">
  <div class="panel payment-card">
    <div class="payment-status-row"><span class="status status-<%= deposit.status %>"><%= deposit.status %></span><strong><%= deposit.depositNumber %></strong></div>
    <% if (deposit.status === 'pending') { %>
      <% if (deposit.paymentMethod === 'qris' && deposit.paymentQrDataUrl) { %><div class="qr-box"><img src="<%= deposit.paymentQrDataUrl %>" alt="QR pembayaran"><p>Pindai QR menggunakan aplikasi pembayaran Anda.</p></div><% } else { %><div class="payment-number"><small>Nomor pembayaran</small><strong><%= deposit.paymentNumber %></strong><button class="button button-sm button-ghost" type="button" data-copy="<%= deposit.paymentNumber %>">Salin</button></div><% } %>
      <% if (deposit.expiresAt) { %><div class="countdown-box" data-payment-expiry="<%= deposit.expiresAt.toISOString() %>"><span>Selesaikan dalam</span><strong data-countdown>--:--:--</strong></div><% } %>
      <div class="actions"><form method="post" action="/wallet/deposits/<%= deposit.depositNumber %>/check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button" type="submit" data-submit-lock>Saya sudah bayar</button></form><form method="post" action="/wallet/deposits/<%= deposit.depositNumber %>/cancel" data-confirm="Batalkan deposit ini?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-ghost" type="submit">Batalkan</button></form></div>
    <% } else if (deposit.status === 'paid') { %><div class="payment-success"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg><h2>Saldo sudah masuk</h2><p>Deposit berhasil ditambahkan ke dompet Anda.</p><a class="button" href="/wallet">Buka dompet</a></div><% } else { %><div class="empty compact"><h3>Deposit <%= deposit.status %></h3><p>Anda dapat membuat deposit baru kapan saja.</p><a class="button" href="/wallet/deposit">Isi saldo lagi</a></div><% } %>
  </div>
  <aside class="summary-card"><h2>Rincian</h2><div class="summary-row"><span>Saldo yang diterima</span><strong><%= rupiah(deposit.amount) %></strong></div><div class="summary-row"><span>Biaya layanan</span><strong><%= rupiah(deposit.gatewayFee) %></strong></div><hr><div class="summary-row total"><span>Total pembayaran</span><strong><%= rupiah(deposit.totalPayment) %></strong></div><p class="muted">Saldo masuk sesuai nominal deposit setelah pembayaran selesai.</p></aside>
</div></section>
