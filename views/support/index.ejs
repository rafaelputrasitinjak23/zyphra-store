<section class="page-head">
  <div class="container">
    <span class="eyebrow">BANTUAN</span>
    <h1>Tiket bantuan</h1>
    <p>Kirim pertanyaan terkait produk, instalasi, pesanan, atau akun Anda.</p>
  </div>
</section>

<section class="section pt-small">
  <div class="container">
    <div class="panel">
      <div class="panel-head">
        <div><span class="eyebrow">RIWAYAT TIKET</span><h2>Daftar tiket</h2></div>
        <a class="button button-sm" href="/support/new">Buat tiket</a>
      </div>

      <% if (!tickets.length) { %>
        <div class="empty compact"><h3>Belum ada tiket</h3><p>Buat tiket jika membutuhkan bantuan terkait produk.</p><a class="button button-sm" href="/support/new">Buat tiket pertama</a></div>
      <% } else { %>
        <div class="support-ticket-list">
          <% tickets.forEach(ticket => { %>
            <a class="support-ticket-card" href="/support/<%= ticket.ticketNumber %>">
              <div>
                <span class="status status-<%= ticket.status %>"><%= ticket.status %></span>
                <h3><%= ticket.subject %></h3>
                <p><%= ticket.product?.name || 'Pertanyaan umum' %> • <%= ticket.category %></p>
              </div>
              <small><%= formatDate(ticket.latestMessageAt) %></small>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>
