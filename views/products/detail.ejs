<% const pricing = productPrice(product); %>
<section class="section product-detail-section">
  <div class="container product-detail">
    <div class="gallery-main">
      <img src="<%= product.thumbnail %>" alt="<%= product.name %>">
      <% if (product.gallery?.length) { %>
        <div class="thumb-grid"><% product.gallery.forEach(image => { %><img src="<%= image %>" alt="Galeri <%= product.name %>" loading="lazy"><% }) %></div>
      <% } %>
    </div>
    <div class="product-info product-buy-card">
      <div class="meta-row"><span class="badge"><%= product.category?.name %></span><span class="badge">v<%= product.version %></span></div>
      <h1><%= product.name %></h1>
      <p class="lead"><%= product.shortDescription %></p>
      <a class="product-rating-summary" href="#reviews" aria-label="Lihat ulasan produk">
        <span class="review-stars"><% for (let i = 1; i <= 5; i += 1) { %><span class="<%= i <= Math.round(product.ratingAverage || 0) ? 'active' : '' %>">★</span><% } %></span>
        <strong><%= Number(product.ratingAverage || 0).toFixed(1) %></strong>
        <span><%= reviewTotal %> ulasan</span>
      </a>
      <div class="price-label">Harga produk</div>
      <div class="detail-price">
        <% if (pricing.compareAtPrice) { %><span class="old-price"><%= rupiah(pricing.compareAtPrice) %></span><% } %>
        <strong><%= pricing.effectivePrice === 0 ? 'Gratis' : rupiah(pricing.effectivePrice) %></strong>
        <% if (pricing.flashActive) { %><span class="discount-badge">Flash Sale -<%= pricing.discountPercent %>%</span><% } else if (pricing.hasPromo) { %><span class="discount-badge">Promo</span><% } %>
      </div>
      <% if (pricing.flashActive) { %><div class="flash-countdown" data-flash-expiry="<%= pricing.flashEndsAt.toISOString() %>"><span>Flash sale berakhir dalam</span><strong data-flash-countdown>--:--:--</strong></div><% } else if (pricing.flashUpcoming) { %><div class="notice"><strong>Flash sale akan datang</strong><p>Mulai <%= formatDate(pricing.flashStartsAt) %>.</p></div><% } %>
      <p class="price-note"><%= pricing.effectivePrice === 0 ? 'Produk ini dapat langsung diklaim secara gratis.' : 'Rincian pembayaran lengkap ditampilkan saat checkout.' %></p>
      <div class="product-quick-stats">
        <span><strong><%= product.soldCount || 0 %></strong> terjual</span>
        <span><strong><%= product.viewCount || 0 %></strong> dilihat</span>
        <span><strong><%= product.downloadLimit %>×</strong> download</span>
      </div>
      <div class="stock"><span class="status-dot"></span><%= product.unlimitedStock ? 'Stok tidak terbatas' : `${product.stock} tersedia` %></div>
      <% const productAvailable = product.unlimitedStock || product.stock > 0; %>
      <% if (!productAvailable) { %>
        <button class="button button-block" type="button" disabled>Stok sedang habis</button>
      <% } else if (!currentUser) { %>
        <a class="button button-block" href="/auth/login">Login untuk membeli</a>
      <% } else { %>
        <form method="post" action="/cart/add" class="buy-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="productId" value="<%= product._id %>">
          <% if (product.allowMultipleQuantity) { %><label>Jumlah<input type="number" name="quantity" value="1" min="1" max="99"></label><% } %>
          <div class="buy-actions">
            <button class="button button-ghost" type="submit">Tambah ke keranjang</button>
            <button class="button" type="submit" name="next" value="/checkout">Beli sekarang</button>
          </div>
        </form>
      <% } %>

      <div class="feature-product-actions">
        <a class="button button-ghost" href="/docs/<%= product.slug %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"/><path d="M8 7h8M8 11h8"/></svg>
          Dokumentasi
        </a>
        <% if (currentUser) { %>
          <a class="button button-ghost" href="/support/new?product=<%= product._id %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v5h4v-6H4M20 13v5h-4v-6h4M16 19c-1 1.3-2.3 2-4 2"/></svg>
            Bantuan
          </a>
        <% } %>
      </div>
      <div class="safe-note"><svg viewBox="0 0 24 24"><path d="m12 3 8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7zM9 12l2 2 4-4"/></svg><div><strong>Akses produk praktis</strong><span><%= pricing.effectivePrice === 0 ? 'Produk langsung tersedia setelah pesanan dikonfirmasi.' : 'Produk tersedia setelah pesanan selesai.' %></span></div></div>
    </div>
  </div>
</section>
<section class="section section-soft">
  <div class="container detail-tabs">
    <article><h2>Deskripsi</h2><div class="prose preserve-lines"><%= product.description %></div></article>
    <aside class="product-info-card">
      <div class="product-info-card-head">
        <span class="eyebrow">DETAIL</span>
        <h3>Informasi produk</h3>
      </div>
      <dl class="product-info-list">
        <div>
          <dt>Versi</dt>
          <dd><%= product.version %></dd>
        </div>
        <div>
          <dt>Batas download</dt>
          <dd><%= product.downloadLimit %> kali/pesanan</dd>
        </div>
        <div>
          <dt>Diperbarui</dt>
          <dd><%= formatDate(product.updatedAt) %></dd>
        </div>
        <div>
          <dt>Pengiriman</dt>
          <dd><%= pricing.effectivePrice === 0 ? 'Langsung tersedia' : 'Setelah pembayaran selesai' %></dd>
        </div>
      </dl>
      <% if (product.tags?.length) { %>
        <div class="product-tag-section">
          <span>Tag produk</span>
          <div class="tag-list clean-tag-list">
            <% product.tags.forEach(tag => { %><span><%= tag %></span><% }) %>
          </div>
        </div>
      <% } %>
    </aside>
  </div>
</section>
<% if (product.changelog || product.instructions) { %>
<section class="section"><div class="container two-col">
  <% if (product.changelog) { %><article class="panel"><h2>Changelog</h2><div class="prose preserve-lines"><%= product.changelog %></div></article><% } %>
  <% if (product.instructions) { %>
    <% const instructionSteps = String(product.instructions || '').split(/\s*(?=\d+\.\s+)/).map(step => step.trim()).filter(Boolean); %>
    <article class="panel instruction-panel">
      <div class="instruction-head">
        <span class="eyebrow">PANDUAN</span>
        <h2>Instruksi penggunaan</h2>
        <p>Ikuti langkah berikut agar produk dapat digunakan dengan benar.</p>
      </div>
      <% if (instructionSteps.length > 1) { %>
        <ol class="instruction-steps">
          <% instructionSteps.forEach(step => { %>
            <li><%= step.replace(/^\d+\.\s*/, '') %></li>
          <% }) %>
        </ol>
      <% } else { %>
        <div class="prose preserve-lines clean-instruction-text"><%= product.instructions %></div>
      <% } %>
    </article>
  <% } %>
</div></section>
<% } %>
<section class="section section-soft" id="reviews">
  <div class="container review-section">
    <div class="section-head">
      <div><span class="eyebrow">ULASAN PEMBELI</span><h2>Rating & pengalaman pembeli</h2></div>
    </div>
    <div class="review-layout">
      <aside class="rating-overview panel">
        <div class="rating-score"><strong><%= Number(product.ratingAverage || 0).toFixed(1) %></strong><span>/ 5</span></div>
        <div class="review-stars review-stars-large"><% for (let i = 1; i <= 5; i += 1) { %><span class="<%= i <= Math.round(product.ratingAverage || 0) ? 'active' : '' %>">★</span><% } %></div>
        <p>Berdasarkan <strong><%= reviewTotal %></strong> ulasan pembelian.</p>
        <div class="rating-bars">
          <% [5,4,3,2,1].forEach(star => { const count = ratingBreakdown[star] || 0; const percent = reviewTotal ? Math.round((count / reviewTotal) * 100) : 0; %>
            <div><span><%= star %> ★</span><progress value="<%= percent %>" max="100"></progress><small><%= count %></small></div>
          <% }) %>
        </div>
      </aside>

      <div class="review-main">
        <% if (currentUser && canReview) { %>
          <form class="panel review-form" method="post" action="/reviews/products/<%= product._id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="review-form-head"><div><span class="eyebrow">PEMBELIAN TERVERIFIKASI</span><h3><%= currentUserReview ? 'Perbarui ulasan Anda' : 'Bagikan pengalaman Anda' %></h3></div><span class="verified-review-badge">✓ Terverifikasi</span></div>
            <% if (currentUserReview?.status === 'hidden') { %><div class="notice"><strong>Ulasan sedang disembunyikan</strong><p>Perubahan tetap dapat disimpan, tetapi status moderasi tidak berubah otomatis.</p></div><% } %>
            <fieldset class="star-input">
              <legend>Berikan rating</legend>
              <% [5,4,3,2,1].forEach(star => { %>
                <input id="rating-<%= star %>" type="radio" name="rating" value="<%= star %>" <%= Number(currentUserReview?.rating) === star ? 'checked' : '' %> required>
                <label for="rating-<%= star %>" title="<%= star %> bintang">★</label>
              <% }) %>
            </fieldset>
            <label class="review-textarea">Ulasan <small>Opsional, maksimal 1.200 karakter</small><textarea name="comment" rows="4" maxlength="1200" placeholder="Ceritakan pengalaman Anda menggunakan produk ini..."><%= currentUserReview?.comment || '' %></textarea></label>
            <div class="review-form-actions"><button class="button" type="submit"><%= currentUserReview ? 'Simpan perubahan' : 'Kirim ulasan' %></button></div>
          </form>
          <% if (currentUserReview) { %>
            <form class="review-delete-form" method="post" action="/reviews/<%= currentUserReview._id %>/delete" data-confirm="Hapus ulasan ini?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-ghost button-sm" type="submit">Hapus ulasan</button>
            </form>
          <% } %>
        <% } else if (currentUser) { %>
          <div class="panel review-eligibility"><h3>Ulasan pembelian</h3><p>Anda dapat memberikan rating setelah memiliki produk ini melalui pesanan yang berhasil.</p></div>
        <% } else { %>
          <div class="panel review-eligibility"><h3>Sudah menggunakan produk ini?</h3><p>Login dengan akun pembelian Anda untuk memberikan rating.</p><a class="button button-ghost button-sm" href="/auth/login">Login</a></div>
        <% } %>

        <% if (reviews.length) { %>
          <div class="review-list">
            <% reviews.forEach(review => { %>
              <article class="review-card">
                <div class="review-author">
                  <div class="review-avatar"><% if (review.user?.avatar) { %><img src="<%= review.user.avatar %>" alt="Foto <%= review.user.name %>"><% } else { %><span><%= String(review.user?.name || 'P').charAt(0).toUpperCase() %></span><% } %></div>
                  <div><strong><%= review.user?.name || 'Pembeli' %></strong><span class="verified-review-badge">✓ Pembelian terverifikasi</span></div>
                  <time><%= formatDate(review.createdAt) %></time>
                </div>
                <div class="review-stars"><% for (let i = 1; i <= 5; i += 1) { %><span class="<%= i <= review.rating ? 'active' : '' %>">★</span><% } %></div>
                <% if (review.comment) { %><p class="review-comment"><%= review.comment %></p><% } %>
                <% if (String(review.user?._id) === String(currentUser?._id) && review.updatedAt > review.createdAt) { %><small class="review-edited">Diperbarui</small><% } %>
              </article>
            <% }) %>
          </div>
          <% if (reviewPagination.totalPages > 1) { %>
            <nav class="pagination" aria-label="Halaman ulasan">
              <a class="button button-sm button-ghost <%= reviewPagination.page <= 1 ? 'disabled' : '' %>" href="<%= reviewPagination.page > 1 ? `/products/${product.slug}?reviewPage=${reviewPagination.page - 1}#reviews` : '#' %>">Sebelumnya</a>
              <span>Halaman <strong><%= reviewPagination.page %></strong> dari <strong><%= reviewPagination.totalPages %></strong></span>
              <a class="button button-sm button-ghost <%= reviewPagination.page >= reviewPagination.totalPages ? 'disabled' : '' %>" href="<%= reviewPagination.page < reviewPagination.totalPages ? `/products/${product.slug}?reviewPage=${reviewPagination.page + 1}#reviews` : '#' %>">Berikutnya</a>
            </nav>
          <% } %>
        <% } else { %>
          <div class="empty compact"><h3>Belum ada ulasan</h3><p>Jadilah pembeli pertama yang memberikan rating.</p></div>
        <% } %>
      </div>
    </div>
  </div>
</section>
<% if (related?.length) { %>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">REKOMENDASI</span><h2>Produk terkait</h2></div></div><div class="product-grid"><% related.forEach(item => { %><%- include('../partials/product-card', { product: item }) %><% }) %></div></div></section>
<% } %>
<% if (recentlyViewed?.length) { %>
<section class="section section-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">TERAKHIR DILIHAT</span><h2>Lanjutkan penjelajahan</h2></div></div><div class="product-grid"><% recentlyViewed.forEach(item => { %><%- include('../partials/product-card', { product: item }) %><% }) %></div></div></section>
<% } %>
