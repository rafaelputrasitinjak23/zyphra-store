<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title><%= order.invoiceNumber %></title><style>body{font-family:Arial,sans-serif;color:#18181b;margin:0;padding:32px}.invoice{max-width:820px;margin:auto}.top{display:flex;justify-content:space-between;gap:24px;border-bottom:2px solid #111827;padding-bottom:20px}.logo{font-size:24px;font-weight:800}.status{padding:7px 12px;background:#eee;border-radius:99px;text-transform:uppercase;font-weight:700;font-size:12px}table{width:100%;border-collapse:collapse;margin:24px 0}th,td{text-align:left;padding:12px;border-bottom:1px solid #ddd}th:last-child,td:last-child{text-align:right}.summary{margin-left:auto;width:360px}.summary div{display:flex;justify-content:space-between;padding:7px 0}.total{font-size:19px;font-weight:bold;border-top:2px solid #111;padding-top:12px!important}.meta{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:25px}.muted{color:#666}@media print{button{display:none}body{padding:0}}@media(max-width:600px){.top,.meta{display:block}.summary{width:100%}}</style></head><body><div class="invoice"><div class="top"><div><div class="logo">Zyphra Store</div><p class="muted">Invoice produk digital</p></div><div><span class="status"><%= order.paymentStatus %></span><p><strong><%= order.invoiceNumber %></strong></p></div></div><div class="meta"><div><h3>Ditagihkan kepada</h3><p><%= order.buyerSnapshot.name %><br><%= order.buyerSnapshot.email %></p></div><div><h3>Informasi transaksi</h3><p>Pesanan: <%= order.orderNumber %><br>Tanggal: <%= formatDate(order.createdAt) %><br>Dibayar: <%= formatDate(order.paidAt) %></p></div></div><table><thead><tr><th>Produk</th><th>Harga</th><th>Jumlah</th><th>Total</th></tr></thead><tbody><% order.items.forEach(item => { %><tr><td><%= item.name %></td><td><%= rupiah(item.unitPrice) %></td><td><%= item.quantity %></td><td><%= rupiah(item.lineTotal) %></td></tr><% }) %></tbody></table><div class="summary"><div><span>Subtotal produk</span><b><%= rupiah(order.itemsSubtotal || (order.subtotal + (order.discountAmount || 0))) %></b></div><% if (order.discountAmount > 0) { %><div><span><%= order.discountKind === 'voucher' ? 'Voucher' : 'Kode promo' %> <%= order.discountCodeText %></span><b>-<%= rupiah(order.discountAmount) %></b></div><div><span>Subtotal setelah diskon</span><b><%= rupiah(order.subtotal) %></b></div><% } %><div><span>Gateway fee</span><b><%= rupiah(order.gatewayFee) %></b></div><div><span>Fee pengguna</span><b><%= rupiah(order.userFee) %></b></div><div><span>Fee merchant</span><b><%= rupiah(order.merchantFee) %></b></div><div><span>Pendapatan bersih merchant</span><b><%= rupiah(order.merchantNet) %></b></div><div class="total"><span>Total pembayaran</span><b><%= rupiah(order.total) %></b></div></div><p class="muted">Invoice ini dibuat otomatis dan dapat dicetak dari browser.</p><button onclick="window.print()">Cetak invoice</button></div></body></html>
