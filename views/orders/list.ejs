<section class="page-head"><div class="container"><span class="eyebrow">PESANAN</span><h1>Riwayat pesanan</h1></div></section><section class="section pt-small"><div class="container"><% if (!orders.length) { %><div class="empty"><h3>Belum ada pesanan</h3><a class="button" href="/products">Mulai belanja</a></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Pesanan</th><th>Tanggal</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><strong><%= order.orderNumber %></strong><small><%= order.items.length %> produk</small></td><td><%= formatDate(order.createdAt) %></td><td><%= rupiah(order.total) %></td><td><span class="status status-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></td><td><a href="/orders/<%= order.orderNumber %>">Detail →</a></td></tr><% }) %></tbody></table></div><% } %></div></section>
