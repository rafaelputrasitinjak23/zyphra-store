<section class="page-head"><div class="container"><span class="eyebrow">DETAIL PESANAN</span><h1><%= order.orderNumber %></h1><p>Dibuat <%= formatDate(order.createdAt) %></p></div></section>
<section class="section pt-small"><div class="container checkout-grid"><div>
  <div class="panel"><div class="panel-head"><h2>Produk</h2><span class="status status-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></div>
    <% order.items.forEach(item => { %><div class="order-item"><img src="<%= item.thumbnail %>" alt="<%= item.name %>"><div><strong><%= item.name %></strong><span>v<%= item.version %> · <%= item.quantity %> item</span></div><b><%= rupiah(item.lineTotal) %></b></div><% }) %>
    <% if (order.paymentStatus === 'cancelled' && order.cancellationReason) { %><div class="notice notice-danger"><strong>Pesanan dibatalkan</strong><p><%= order.cancellationReason %> · <%= formatDate(order.cancelledAt) %></p></div><% } %>
    <% if (order.walletReleased) { %><div class="notice"><strong>Saldo telah dikembalikan</strong><p>Saldo yang sempat digunakan sudah kembali ke dompet Anda.</p></div><% } %>
  </div>
  <div class="actions"><a class="button button-ghost" target="_blank" href="/orders/<%= order.orderNumber %>/invoice">Cetak invoice</a><% if (order.paymentStatus === 'pending') { %><a class="button" href="/payments/<%= order.orderNumber %>">Lanjutkan pembayaran</a><form method="post" action="/orders/<%= order.orderNumber %>/cancel" data-confirm="Yakin ingin membatalkan transaksi ini?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-ghost" type="submit">Batalkan transaksi</button></form><% } %><% if (order.paymentStatus === 'paid') { %><a class="button" href="/account/purchases">Buka produk saya</a><% } %></div>
</div><aside class="summary-card"><h2>Ringkasan</h2><div class="summary-row"><span>Subtotal produk</span><strong><%= rupiah(order.itemsSubtotal || (order.subtotal + (order.discountAmount || 0))) %></strong></div><% if (order.discountAmount > 0) { %><div class="summary-row discount-row"><span><%= order.discountKind === 'voucher' ? 'Voucher' : 'Kode promo' %> <strong><%= order.discountCodeText %></strong></span><strong>-<%= rupiah(order.discountAmount) %></strong></div><% } %><% if (order.walletAmount > 0) { %><div class="summary-row"><span>Dibayar dengan saldo</span><strong><%= rupiah(order.walletAmount) %></strong></div><% } %><% if (order.userFee > 0) { %><div class="summary-row"><span>Biaya layanan</span><strong><%= rupiah(order.userFee) %></strong></div><% } %><hr><div class="summary-row total"><span>Total transaksi</span><strong><%= order.total === 0 ? 'Gratis' : rupiah(order.total) %></strong></div><div class="summary-row"><span>Cara pembayaran</span><strong><%= order.paymentChannel === 'free' ? 'Gratis' : order.paymentChannel === 'wallet' ? 'Saldo TOKOZYPHRA' : order.paymentChannel === 'hybrid' ? `Saldo + ${order.paymentMethod.toUpperCase().replaceAll('_', ' ')}` : order.paymentMethod.toUpperCase().replaceAll('_', ' ') %></strong></div><div class="summary-row"><span>Invoice</span><strong><%= order.invoiceNumber %></strong></div></aside></div></section>
