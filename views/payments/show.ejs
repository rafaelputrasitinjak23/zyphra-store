<section class="page-head"><div class="container"><span class="eyebrow">PEMBAYARAN</span><h1><%= order.orderNumber %></h1><p>Selesaikan pembayaran sebelum <%= formatDate(order.expiresAt) %>.</p></div></section>
<section class="section pt-small"><div class="container payment-layout">
  <div class="panel payment-box">
    <div class="status status-<%= order.paymentStatus %>"><span></span><%= order.paymentStatus.toUpperCase() %></div>
    <% if (order.paymentStatus === 'pending') { %>
      <div class="payment-countdown" data-payment-expiry="<%= order.expiresAt?.toISOString?.() || '' %>">Sisa waktu: <strong data-countdown>menghitung...</strong></div>
      <h2><%= order.paymentMethod === 'qris' ? 'Pindai QR pembayaran' : 'Nomor Virtual Account' %></h2>
      <% if (order.paymentMethod === 'qris' && order.paymentQrDataUrl) { %><img class="qr-image" src="<%= order.paymentQrDataUrl %>" alt="QR pembayaran"><p class="muted center">Gunakan aplikasi bank atau dompet digital yang mendukung QRIS.</p><% } else { %><div class="payment-number"><code><%= order.paymentNumber %></code><button class="button button-sm button-ghost" type="button" data-copy="<%= order.paymentNumber %>">Salin</button></div><% } %>
      <% if (order.walletAmount > 0) { %><div class="wallet-applied-note"><svg viewBox="0 0 24 24"><path d="M4 7h16v12H4zM16 11h5v5h-5z"/></svg><div><strong>Saldo <%= rupiah(order.walletAmount) %> sudah digunakan</strong><small>Sisa pembayaran diselesaikan melalui metode di atas.</small></div></div><% } %>
      <form method="post" action="/payments/<%= order.orderNumber %>/check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-block" type="submit" data-submit-lock>Saya sudah membayar</button></form>
      <form method="post" action="/orders/<%= order.orderNumber %>/cancel" data-confirm="Batalkan transaksi ini?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reason" value="Dibatalkan dari halaman pembayaran"><button class="button button-block button-danger-ghost" type="submit">Batalkan transaksi</button></form>
    <% } else { %><p>Transaksi ini berstatus <strong><%= order.paymentStatus %></strong>.</p><a class="button button-block" href="/orders/<%= order.orderNumber %>">Lihat detail pesanan</a><% } %>
  </div>
  <aside class="summary-card"><h2>Rincian pembayaran</h2><div class="summary-row"><span>Subtotal produk</span><strong><%= rupiah(order.itemsSubtotal || (order.subtotal + (order.discountAmount || 0))) %></strong></div><% if (order.discountAmount > 0) { %><div class="summary-row discount-row"><span><%= order.discountKind === 'voucher' ? 'Voucher' : 'Kode promo' %> <strong><%= order.discountCodeText %></strong></span><strong>-<%= rupiah(order.discountAmount) %></strong></div><% } %><% if (order.walletAmount > 0) { %><div class="summary-row"><span>Saldo dompet</span><strong>-<%= rupiah(order.walletAmount) %></strong></div><% } %><div class="summary-row"><span>Biaya layanan</span><strong><%= rupiah(order.userFee) %></strong></div><hr><div class="summary-row total"><span>Bayar sekarang</span><strong><%= rupiah(Math.max(0, order.total - order.walletAmount)) %></strong></div></aside>
</div></section>
