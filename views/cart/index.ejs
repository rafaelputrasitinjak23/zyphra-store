<section class="page-head"><div class="container"><span class="eyebrow">KERANJANG</span><h1>Keranjang belanja</h1></div></section><section class="section pt-small"><div class="container"><% if (!items.length) { %><div class="empty"><h3>Keranjang masih kosong</h3><p>Tambahkan produk untuk melanjutkan checkout.</p><a class="button" href="/products">Jelajahi produk</a></div><% } else { %><div class="checkout-grid"><div class="cart-list"><% items.forEach(({ product, quantity, unitPrice, lineTotal }) => { const cartItem = cart.items.find(i => String(i.product._id || i.product) === String(product._id)); %><article class="cart-item"><img src="<%= product.thumbnail %>" alt="<%= product.name %>"><div><span class="badge"><%= product.category?.name || 'Digital' %></span><h3><a href="/products/<%= product.slug %>"><%= product.name %></a></h3><p><%= rupiah(unitPrice) %></p></div><div class="cart-actions"><% if (product.allowMultipleQuantity) { %><form method="post" action="/cart/<%= cartItem._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" name="quantity" value="<%= quantity %>" min="1" max="99"><button class="button button-sm button-ghost">Ubah</button></form><% } else { %><span>1 item</span><% } %><strong><%= rupiah(lineTotal) %></strong><form method="post" action="/cart/<%= cartItem._id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button danger">Hapus</button></form></div></article><% }) %></div><aside class="summary-card"><h2>Ringkasan</h2><div class="summary-row"><span>Subtotal</span><strong><%= rupiah(subtotal) %></strong></div><p class="muted">Fee pembayaran ditampilkan setelah memilih metode di checkout.</p><a class="button button-block" href="/checkout">Lanjut ke checkout</a><a class="button button-block button-ghost" href="/products">Tambah produk lain</a></aside></div><% } %></div></section>
