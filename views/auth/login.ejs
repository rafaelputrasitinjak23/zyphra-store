<section class="auth-section">
  <div class="auth-card">
    <div class="auth-heading">
      <span class="brand-mark">Z</span>
      <h1>Login</h1>
      <p>Masuk menggunakan email, password, dan CAPTCHA teks.</p>
    </div>
    <form method="post" action="/auth/login" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email<input type="email" name="email" required autocomplete="email"></label>
      <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
      <div class="form-between"><span></span><a href="/auth/forgot-password">Lupa password?</a></div>
      <%- include('../partials/captcha', { captchaId }) %>
      <button class="button button-block" type="submit">Login</button>
    </form>
    <p class="auth-foot">Belum punya akun? <a href="/auth/register">Daftar</a></p>
  </div>
</section>
