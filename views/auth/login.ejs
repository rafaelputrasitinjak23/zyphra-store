<section class="auth-section"><div class="auth-card"><div class="auth-heading"><span class="brand-mark">Z</span><h1>Login</h1><p>Login manual dilanjutkan dengan verifikasi OTP.</p></div><form method="post" action="/auth/login" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email<input type="email" name="email" required autocomplete="email"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><div class="form-between"><span></span><a href="/auth/forgot-password">Lupa password?</a></div><% if (turnstileSiteKey) { %><div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>"></div><% } %><button class="button button-block" type="submit">Lanjutkan</button></form><div class="divider"><span>atau masuk tanpa OTP</span></div><div class="oauth-grid"><a class="button button-ghost" href="/auth/google">Google</a><a class="button button-ghost" href="/auth/github">GitHub</a></div><p class="auth-foot">Belum punya akun? <a href="/auth/register">Daftar</a></p></div></section>
