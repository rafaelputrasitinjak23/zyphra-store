<section class="auth-section">
  <div class="auth-card">
    <div class="auth-heading"><span class="brand-mark">Z</span><h1>Selamat datang kembali</h1><p>Masuk untuk melanjutkan belanja dan mengelola akun.</p></div>
    <form method="post" action="/auth/login" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><%- include('../partials/captcha') %><button class="button button-block" type="submit" data-submit-lock>Masuk</button></form>
    <div class="auth-links"><a href="/auth/forgot-password">Lupa password?</a><span>Belum punya akun? <a href="/auth/register">Daftar</a></span></div>
  </div>
</section>
