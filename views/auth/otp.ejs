<section class="auth-section"><div class="auth-card"><div class="auth-heading"><span class="brand-mark">Z</span><h1>Periksa email Anda</h1><p>Masukkan kode enam digit yang dikirim ke <strong><%= email.replace(/^(.{2}).+(@.+)$/, '$1***$2') %></strong>.</p></div><form method="post" action="/auth/otp/<%= flow %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Kode verifikasi<input class="otp-input" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"></label><button class="button button-block" type="submit">Lanjutkan</button></form><form method="post" action="/auth/otp/<%= flow %>/resend" class="inline-center"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Kirim kode baru</button></form></div></section>
