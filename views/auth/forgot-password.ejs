<section class="auth-section">
  <div class="auth-card">
    <div class="auth-heading">
      <span class="brand-mark">Z</span>
      <h1>Lupa password</h1>
      <p>Masukkan email. Respons tidak akan mengungkap apakah email terdaftar.</p>
    </div>
    <form method="post" action="/auth/forgot-password" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email<input type="email" name="email" required autocomplete="email"></label>
      <%- include('../partials/captcha', { captchaId }) %>
      <button class="button button-block" type="submit">Kirim instruksi</button>
    </form>
    <p class="auth-foot"><a href="/auth/login">Kembali ke login</a></p>
  </div>
</section>
