<section class="auth-section"><div class="auth-card"><div class="auth-heading"><span class="brand-mark">Z</span><h1>Password baru</h1><p>Seluruh sesi lama akan dinonaktifkan.</p></div><form method="post" action="/auth/reset-password" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Password baru<input type="password" name="password" required minlength="8"></label><label>Konfirmasi password<input type="password" name="confirmPassword" required minlength="8"></label><button class="button button-block" type="submit">Simpan password</button></form></div></section>
