<% const pricing = productPrice(product); %>
<% const stockAvailable = product.unlimitedStock || availableStock(product) > 0; %>
<article class="product-card market-product-card <%= !stockAvailable ? 'is-sold-out' : '' %>">
  <a class="product-image market-product-image" href="/products/<%= product.slug %>" aria-label="Lihat <%= product.name %>">
    <img src="<%= product.thumbnail %>" alt="Thumbnail <%= product.name %>" loading="lazy">
    <div class="market-product-badges" aria-hidden="true">
      <span class="market-product-badge-left <%= pricing.flashActive ? 'is-flash' : '' %>">
        <% if (pricing.flashActive) { %>FLASH SALE<% } else if (product.featured) { %>UNGGULAN<% } else { %><%= product.category?.name || 'DIGITAL' %><% } %>
      </span>
      <% if (pricing.discountPercent > 0) { %><span class="market-discount-badge">-<%= pricing.discountPercent %>%</span><% } %>
    </div>
    <% if (!stockAvailable) { %><span class="market-soldout-overlay">Stok habis</span><% } %>
  </a>

  <div class="product-body market-product-body">
    <span class="product-field-label sr-only">Nama script</span>
    <h3 class="market-product-title"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>

    <div class="market-product-pricing">
      <span class="product-field-label sr-only">Harga script</span>
      <% if (pricing.compareAtPrice) { %><span class="old-price"><%= rupiah(pricing.compareAtPrice) %></span><% } else { %><span class="old-price is-placeholder" aria-hidden="true">&nbsp;</span><% } %>
      <strong><%= pricing.effectivePrice === 0 ? 'Gratis' : rupiah(pricing.effectivePrice) %></strong>
    </div>

    <div class="market-product-meta">
      <span class="market-rating"><b aria-hidden="true">★</b><strong><%= Number(product.ratingAverage || 0).toFixed(1) %></strong><small>(<%= product.ratingCount || 0 %>)</small></span>
      <span class="market-sold"><%= product.soldCount || 0 %> terjual</span>
    </div>
  </div>
</article>
