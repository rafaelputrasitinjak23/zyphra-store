<article class="product-card"><a class="product-image" href="/products/<%= product.slug %>"><img src="<%= product.thumbnail %>" alt="<%= product.name %>" loading="lazy"></a><div class="product-body"><div class="meta-row"><span class="badge"><%= product.category?.name || 'Digital' %></span><% if (product.featured) { %><span class="badge badge-accent">Unggulan</span><% } %></div><h3><a href="/products/<%= product.slug %>"><%= product.name %></a></h3><p><%= product.shortDescription %></p><div class="price-row"><div><% if (product.promoPrice !== null && product.promoPrice < product.price) { %><span class="old-price"><%= rupiah(product.price) %></span><strong><%= rupiah(product.promoPrice) %></strong><% } else { %><strong><%= rupiah(product.price) %></strong><% } %></div><a class="icon-link" href="/products/<%= product.slug %>" aria-label="Lihat detail"><svg viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div></div></article>
