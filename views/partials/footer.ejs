<footer class="site-footer site-footer-modern">
  <div class="container footer-modern-grid">
    <section class="footer-brand-column" aria-labelledby="footer-brand-title">
      <a class="brand footer-brand" href="/" aria-label="Zyphra Store">
        <span class="brand-mark">Z</span>
        <span id="footer-brand-title">Zyphra Store</span>
      </a>
      <p class="footer-description">Temukan script, bot, template, plugin, dan produk digital pilihan untuk membantu proyek Anda berkembang lebih cepat.</p>
      <div class="footer-benefits" aria-label="Keunggulan layanan">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 2.9 7.8 7.5 9.5 4.6-1.7 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg>Transaksi nyaman</span>
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13H11l-1 9L19.5 10H13z"/></svg>Akses cepat</span>
      </div>
    </section>

    <nav class="footer-link-column" aria-label="Jelajahi Zyphra Store">
      <h2>Jelajahi</h2>
      <a href="/products"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16l-1 13H5z"/><path d="M8 7a4 4 0 0 1 8 0"/></svg><span>Semua produk</span></a>
      <a href="/cart"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M3 4h2l2.5 11h10l2-8H6"/></svg><span>Keranjang</span></a>
