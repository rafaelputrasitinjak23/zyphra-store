    <section class="footer-support-card" aria-labelledby="footer-support-title">
      <span class="footer-support-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v5h4v-6H4M20 13v5h-4v-6h4M16 19c-1 1.3-2.3 2-4 2"/></svg></span>
      <div>
        <small>BUTUH BANTUAN?</small>
        <h2 id="footer-support-title">Kami siap membantu</h2>
        <p>Kelola pembelian dan temukan bantuan langsung melalui akun Anda.</p>
      </div>
      <a class="footer-support-link" href="<%= currentUser ? '/account' : '/products' %>">
        <span><%= currentUser ? 'Buka akun' : 'Mulai belanja' %></span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
