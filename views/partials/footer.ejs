  <div class="container footer-modern-bottom">
    <p>© <%= new Date().getFullYear() %> Zyphra Store. Semua hak dilindungi.</p>
    <div class="footer-bottom-features" aria-label="Informasi layanan">
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 2.9 7.8 7.5 9.5 4.6-1.7 7.5-4.9 7.5-9.5V6z"/></svg>Belanja aman</span>
      <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M12 4v16"/></svg>Produk digital pilihan</span>
    </div>
  </div>
</footer>
