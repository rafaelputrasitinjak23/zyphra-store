<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Zyphra Store"><span class="brand-mark">Z</span><span>Zyphra Store</span></a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-label="Buka navigasi"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    <nav class="nav" data-nav>
      <a class="<%= currentPath.startsWith('/products') ? 'active' : '' %>" href="/products">Produk</a>
      <% if (currentUser) { %>
        <a href="/cart">Keranjang</a><a href="/orders">Pesanan</a><a href="/account/purchases">Produk Saya</a>
        <% if (currentUser.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <a class="header-account <%= currentPath.startsWith('/account') ? 'active' : '' %>" href="/account">
          <% if (currentUser.avatar) { %><img src="<%= currentUser.avatar %>" alt="Foto <%= currentUser.name %>"><% } else { %><span><%= currentUser.name.charAt(0).toUpperCase() %></span><% } %>
          <b><%= currentUser.name %></b>
        </a>
      <% } else { %>
        <a href="/auth/login">Login</a><a class="button button-sm" href="/auth/register">Daftar</a>
      <% } %>
    </nav>
  </div>
</header>
