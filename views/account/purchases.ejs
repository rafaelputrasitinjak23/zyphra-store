<section class="page-head"><div class="container"><span class="eyebrow">PUSTAKA</span><h1>Produk saya</h1><p>File hanya dapat diakses dari pesanan yang sudah dibayar.</p></div></section><section class="section pt-small"><div class="container"><% if (!orders.length) { %><div class="empty"><h3>Belum ada produk</h3><p>Produk yang sudah dibayar akan muncul di sini.</p><a class="button" href="/products">Belanja sekarang</a></div><% } else { %><div class="purchase-grid"><% orders.forEach(order => { order.items.forEach(item => { %><article class="purchase-card"><img src="<%= item.thumbnail %>" alt="<%= item.name %>"><div><span class="badge">v<%= item.version %></span><h3><%= item.name %></h3><p>Pesanan <%= order.orderNumber %></p><div class="download-progress"><span><%= item.downloadsUsed %> / <%= item.downloadLimit %> download</span><progress value="<%= item.downloadsUsed %>" max="<%= item.downloadLimit %>"></progress></div><a class="button button-block <%= item.downloadsUsed >= item.downloadLimit ? 'disabled' : '' %>" href="/downloads/<%= order._id %>/<%= item.product %>/token">Download</a></div></article><% }) }) %></div><% } %></div></section>
