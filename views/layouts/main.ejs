<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Zyphra Store - produk digital untuk developer dan kreator.">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="current-path" content="<%= currentPath %>">
  <title><%= title ? `${title} — Zyphra Store` : 'Zyphra Store' %></title>
  <link rel="stylesheet" href="/public/css/app.css?v=1.7.0-wallet-2.0.0-responsive-nav">
  <script src="/public/js/app.js?v=1.7.0-wallet-2.0.0-responsive-nav" defer></script>
</head>
<body class="<%= currentPath.startsWith('/admin') ? 'is-admin-page' : '' %>">
  <%- include('../partials/header') %>
  <%- include('../partials/toasts') %>
  <main class="<%= currentPath.startsWith('/admin') ? 'admin-main' : '' %>"><%- body %></main>
  <% if (!currentPath.startsWith('/admin')) { %>
    <%- include('../partials/footer') %>
    <%- include('../partials/ai-chat') %>
    <%- include('../partials/bottom-nav') %>
  <% } %>
</body>
</html>
