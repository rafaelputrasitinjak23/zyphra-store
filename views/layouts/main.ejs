<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="TOKOZYPHRA - marketplace script, bot, template, API, dan source code digital.">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="current-path" content="<%= currentPath %>">
  <title><%= title ? `${title} — TOKOZYPHRA` : 'TOKOZYPHRA' %></title>
  <meta name="theme-color" content="#111827">
  <link rel="manifest" href="/public/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/public/icons/icon-192.svg">
  <link rel="stylesheet" href="/public/css/app.css?v=4.5.1-logo-white-bg">
  <link rel="stylesheet" href="/public/css/feature-pack.css?v=1.0.0-support-notification-docs-pwa">
  <script src="/public/js/app.js?v=4.5.1-logo-white-bg" defer></script>
</head>
<body class="ui-clean <%= currentPath.startsWith('/admin') ? 'is-admin-page' : '' %>">
  <% if (!currentPath.startsWith('/admin')) { %>
    <%- include('../partials/header') %>
  <% } %>
  <%- include('../partials/toasts') %>
  <main class="<%= currentPath.startsWith('/admin') ? 'admin-main' : '' %>"><%- body %></main>
  <% if (!currentPath.startsWith('/admin')) { %>
    <%- include('../partials/footer') %>
    <%- include('../partials/ai-chat') %>
    <%- include('../partials/support-popup') %>
    <%- include('../partials/bottom-nav') %>
  <% } %>
</body>
</html>
